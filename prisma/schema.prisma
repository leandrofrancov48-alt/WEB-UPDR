generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  nombre       String
  apellido     String
  celular      String
  dni          String    @unique
  birthDate    DateTime?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  predictions  ProdePrediction[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProdeTournament {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  matches   ProdeMatch[]
}

model ProdeMatch {
  id           String            @id @default(cuid())
  tournamentId String
  homeTeam     String
  awayTeam     String
  kickoffAt    DateTime
  homeGoals    Int?
  awayGoals    Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tournament   ProdeTournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  predictions  ProdePrediction[]

  @@unique([tournamentId, homeTeam, awayTeam, kickoffAt])
  @@index([tournamentId, kickoffAt])
}

model ProdePrediction {
  id        String    @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     ProdeMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}
