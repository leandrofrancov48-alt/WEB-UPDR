generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  nombre             String
  apellido           String
  celular            String?
  dni                String?              @unique
  passwordHash       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  birthDate          DateTime?
  username           String               @unique
  artistApplications ArtistApplication[]
  predictions        Prediction[]
  ownedGroups        PrivateGroup[]       @relation("GroupOwner")
  privateGroups      PrivateGroupMember[]
  sessions           Session[]
  packBalance        Int                  @default(0)
  hasClaimedWelcome  Boolean              @default(false)
  watchTimeMinutes       Int                  @default(0)
  lastWatchPackDate      DateTime?
  hasReceived20PtsPack   Boolean              @default(false)
  show20PtsNotification  Boolean              @default(false)
  pack2Balance           Int                  @default(0)
  pack3Balance           Int                  @default(0)
  hasReceived40PtsPack   Boolean              @default(false)
  show40PtsNotification  Boolean              @default(false)
  showPlenoNotification  Boolean              @default(false)
  lastActiveSlot         String?
  lastPackSlot           String?
  lastWeeklyPackDate     DateTime?
  stickers               UserSticker[]
  
  // Social Network Fields
  profilePic         String?
  bio                String?
  instrument         String?
  isMusician         Boolean              @default(false)
  showPersonalData   Boolean              @default(false)
  showContactPhone   Boolean              @default(false)
  
  bandsOwned         Band[]               @relation("BandOwner")
  memberships        BandMember[]
  mediaUrls          String[]

  latitude           Float?
  longitude          Float?

  likesGiven         MusicianLike[]       @relation("LikeGiver")
  likesReceived      MusicianLike[]       @relation("LikeReceiver")
  bandLikesGiven     BandLike[]
  openedPacks        OpenedPack[]
  artistDeletionReason String?
}

model ArtistApplication {
  id           String   @id @default(cuid())
  userId       String
  artistName   String
  genre        String?
  bio          String?
  instagram    String?
  spotify      String?
  youtube      String?
  address      String
  street       String?
  number       String?
  city         String?
  postalCode   String?
  mediaUrls    String[]
  profilePic   String?
  registrationType String @default("BAND")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contactPhone String?
  showEmail    Boolean  @default(false)
  showName     Boolean  @default(false)
  showPhone    Boolean  @default(false)
  
  lat          Float?
  lng          Float?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Band {
  id           String       @id @default(cuid())
  name         String
  bio          String?
  profilePic   String?
  coverPic     String?
  genre        String?
  instagram    String?
  spotify      String?
  youtube      String?
  ownerId      String
  owner        User         @relation("BandOwner", fields: [ownerId], references: [id])
  members      BandMember[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  status       String       @default("ACTIVE")
  city         String?
  mediaUrls          String[]
  
  latitude           Float?
  longitude          Float?

  likes              BandLike[]
}

model BandMember {
  id        String   @id @default(cuid())
  bandId    String
  userId    String
  role      String?  // e.g. "Voz", "Guitarra", "Timbal"
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tournament {
  id        String            @id @default(cuid())
  name      String
  status    String            @default("ACTIVE")
  imageUrl  String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  logoUrl   String?
  matches   Match[]
  groups    TournamentGroup[]
}

model TournamentGroup {
  id           String     @id @default(cuid())
  name         String
  tournamentId String
  matches      Match[]
  teams        Team[]
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Team {
  id          String           @id @default(cuid())
  name        String
  flagUrl     String?
  groupId     String?
  awayMatches Match[]          @relation("AwayTeam")
  homeMatches Match[]          @relation("HomeTeam")
  group       TournamentGroup? @relation(fields: [groupId], references: [id])
}

model Match {
  id           String           @id @default(cuid())
  tournamentId String
  groupId      String?
  homeTeamId   String?
  awayTeamId   String?
  matchDate    DateTime
  homeScore    Int?
  awayScore    Int?
  status       String           @default("PENDING")
  phase        String           @default("GROUP")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  awayTeam     Team?            @relation("AwayTeam", fields: [awayTeamId], references: [id])
  group        TournamentGroup? @relation(fields: [groupId], references: [id])
  homeTeam     Team?            @relation("HomeTeam", fields: [homeTeamId], references: [id])
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  predictions  Prediction[]
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points      Int      @default(0)
  packAwarded Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model PrivateGroup {
  id        String               @id @default(cuid())
  name      String
  code      String               @unique
  ownerId   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  owner     User                 @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   PrivateGroupMember[]
}

model PrivateGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  userId    String
  status    String       @default("PENDING")
  createdAt DateTime     @default(now())
  group     PrivateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Sticker {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  image        String
  rarity       String        @default("COMMON") // COMMON, RARE, LEGENDARY
  category     String?       // e.g. "Staff", "Artists", "Moments"
  createdAt    DateTime      @default(now())
  userStickers UserSticker[]
}

model UserSticker {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker   Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
}

model BandLike {
  id        String   @id @default(cuid())
  userId    String
  bandId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  band      Band     @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([userId, bandId])
}

model MusicianLike {
  id                String   @id @default(cuid())
  userId            String
  targetMusicianId  String
  createdAt         DateTime @default(now())
  user              User     @relation("LikeGiver", fields: [userId], references: [id], onDelete: Cascade)
  targetMusician    User     @relation("LikeReceiver", fields: [targetMusicianId], references: [id], onDelete: Cascade)

  @@unique([userId, targetMusicianId])
}

model OpenedPack {
  id        String   @id @default(cuid())
  userId    String
  packType  String   @default("DEFAULT")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
